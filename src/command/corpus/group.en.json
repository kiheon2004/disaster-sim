{
  "class": "group",
  "lang": "en",
  "cases": [
    { "text": "group them as \"North block\"", "expect": ["group it name=\"North block\""] },
    { "text": "group the ones I just made, named \"North block\"", "expect": ["group last name=\"North block\""] },
    { "text": "group the selection", "expect": ["group selection"] },
    { "text": "please group the selected ones", "expect": ["group selection"] },
    { "text": "group these", "expect": ["group selection"] },
    { "text": "group them", "expect": ["group it"] },
    { "text": "group", "expect": ["group it"] },
    { "text": "I want to group them", "expect": ["group it"] },
    { "text": "group all trees", "expect": ["group type:tree"] },
    { "text": "group what I just placed, called \"East row\"", "expect": ["group last name=\"East row\""] },
    { "text": "group these buildings as “Main campus”", "expect": ["group selection name=\"Main campus\""] },
    { "text": "group these called \"Row A\"", "expect": ["group selection name=\"Row A\""] },
    { "text": "group the new ones named \"South row\"", "expect": ["group last name=\"South row\""] },
    { "text": "group all houses with at least 2 floors as \"Two-storey\"", "expect": ["group type:building:house where floors>=2 name=\"Two-storey\""] },
    { "text": "let's group the trees as 'Park trees'", "expect": ["group type:tree name=\"Park trees\""] },
    { "text": "ungroup", "expect": ["ungroup it"] },
    { "text": "ungroup the group \"North block\"", "expect": ["ungroup group:\"North block\""] },
    { "text": "ungroup group \"North block\"", "expect": ["ungroup group:\"North block\""] },
    { "text": "ungroup the selection", "expect": ["ungroup selection"] },
    { "text": "could you ungroup these", "expect": ["ungroup selection"] },
    { "text": "rename it to \"Depot A\"", "expect": ["rename it \"Depot A\""] },
    { "text": "rename the selection to \"Main hall\"", "expect": ["rename selection \"Main hall\""] },
    { "text": "rename the group \"North block\" to \"Block N\"", "expect": ["rename group:\"North block\" \"Block N\""] },
    { "text": "rename \"North block\" to \"South block\"", "expect": ["rename name:\"North block\" \"South block\""] },
    { "text": "call it \"Main gate\"", "expect": ["rename it \"Main gate\""] },
    { "text": "call this \"Car park B\"", "expect": ["rename selection \"Car park B\""] },
    { "text": "rename the new ones to 'Warehouse 3'", "expect": ["rename last \"Warehouse 3\""] },
    { "text": "rename #building_ab12 to ‘City hall’", "expect": ["rename #building_ab12 \"City hall\""] },
    { "text": "rename it", "ask": "name" },
    { "text": "rename it to Depot", "ask": "name" }
  ]
