{
  "class": "group",
  "lang": "ko",
  "cases": [
    { "text": "묶어서 '북쪽 블록'이라고 해", "expect": ["group it name=\"북쪽 블록\""] },
    { "text": "방금 만든 건물들 그룹으로 묶고 이름을 '북쪽 블록'으로", "expect": ["group last name=\"북쪽 블록\""] },
    { "text": "선택한 것 묶어", "expect": ["group selection"] },
    { "text": "선택한것 묶어줘", "expect": ["group selection"] },
    { "text": "이것들 그룹으로 묶어 줘", "expect": ["group selection"] },
    { "text": "그룹 만들어", "expect": ["group it"] },
    { "text": "묶어", "expect": ["group it"] },
    { "text": "그것들 묶을래", "expect": ["group it"] },
    { "text": "나무 전부 그룹으로 묶으세요", "expect": ["group type:tree"] },
    { "text": "방금 만든 것 묶어서 \"동쪽 줄\"이라고 해", "expect": ["group last name=\"동쪽 줄\""] },
    { "text": "이 건물들 그룹으로 묶고 이름을 「본관 단지」로", "expect": ["group selection name=\"본관 단지\""] },
    { "text": "방금 만든 것 묶어서 이름을 '남쪽 줄'로", "expect": ["group last name=\"남쪽 줄\""] },
    { "text": "2층 이상 주택 전부 묶어서 '이층집'이라고 해", "expect": ["group type:building:house where floors>=2 name=\"이층집\""] },
    { "text": "묶어서 'Ａ동 주차장'이라고 해", "expect": ["group it name=\"Ａ동 주차장\""] },
    { "text": "그룹 풀어", "expect": ["ungroup it"] },
    { "text": "'북쪽 블록' 그룹 풀어 줘", "expect": ["ungroup group:\"북쪽 블록\""] },
    { "text": "그룹 '북쪽 블록' 풀어", "expect": ["ungroup group:\"북쪽 블록\""] },
    { "text": "선택한 것 그룹 해제", "expect": ["ungroup selection"] },
    { "text": "이것 그룹해제해", "expect": ["ungroup selection"] },
    { "text": "이름을 '창고 A'로 바꿔", "expect": ["rename it \"창고 A\""] },
    { "text": "선택한 것 이름을 '본관'으로", "expect": ["rename selection \"본관\""] },
    { "text": "'북쪽 블록' 그룹 이름을 'North block'으로 바꿔 주세요", "expect": ["rename group:\"북쪽 블록\" \"North block\""] },
    { "text": "'북쪽 블록' 이름을 '남쪽 블록'으로 바꿔", "expect": ["rename name:\"북쪽 블록\" \"남쪽 블록\""] },
    { "text": "이거 '정문'이라고 불러", "expect": ["rename selection \"정문\""] },
    { "text": "방금 만든 것 이름을 “3번 창고”로 바꿔", "expect": ["rename last \"3번 창고\""] },
    { "text": "#building_ab12 이름을 ‘시청’으로", "expect": ["rename #building_ab12 \"시청\""] },
    { "text": "이름 바꿔", "ask": "name" },
    { "text": "이름을 창고로 바꿔", "ask": "name" }
  ]
}
