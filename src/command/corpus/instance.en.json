{
  "class": "instance",
  "lang": "en",
  "cases": [
    { "text": "stop the earthquake, delete fire #3", "expect": ["disaster earthquake stop", "disaster fire#3 delete"] },
    { "text": "stop the earthquake", "expect": ["disaster earthquake stop"] },
    { "text": "Stop the quake!", "expect": ["disaster earthquake stop"] },
    { "text": "stop the rain", "expect": ["disaster rain stop"] },
    { "text": "stop the typhoon", "expect": ["disaster wind stop"] },
    { "text": "could you stop the flood", "expect": ["disaster risingWater stop"] },
    { "text": "stop the second explosion", "expect": ["disaster blast#2 stop"] },
    { "text": "stop p5", "expect": ["disaster p5 stop"] },
    { "text": "stop all disasters", "expect": ["disaster all stop"] },
    { "text": "pause the fire", "expect": ["disaster fire pause"] },
    { "text": "pause fire #2", "expect": ["disaster fire#2 pause"] },
    { "text": "pause all disasters", "expect": ["disaster all pause"] },
    { "text": "resume the tornado", "expect": ["disaster tornado resume"] },
    { "text": "continue the rain", "expect": ["disaster rain resume"] },
    { "text": "continue the fire", "expect": ["disaster fire resume"] },
    { "text": "please resume the blast", "expect": ["disaster blast resume"] },
    { "text": "resume #p1", "expect": ["disaster p1 resume"] },
    { "text": "delete p3", "expect": ["disaster p3 delete"] },
    { "text": "delete fire #3", "expect": ["disaster fire#3 delete"] },
    { "text": "remove the third fire", "expect": ["disaster fire#3 delete"] },
    { "text": "delete all disasters", "expect": ["disaster all delete"] },
    { "text": "delete the sinkhole", "expect": ["disaster sinkhole delete"] },
    { "text": "remove the meteor", "expect": ["disaster impact delete"] },
    { "text": "delete the black hole", "expect": ["disaster celestial delete"] },
    { "text": "delete the heat source", "expect": ["disaster heatSource delete"] },
    { "text": "move p2 to (10, 10)", "expect": ["disaster p2 move to=10,10"] },
    { "text": "move the fire to this spot", "expect": ["disaster fire move to=cursor"] },
    { "text": "move the tornado to n4", "expect": ["disaster tornado move to=node:n4"] },
    { "text": "move the landslide to the hill", "expect": ["disaster landslide move to=feature:hill"] },
    { "text": "move p4 to 15 m north of the junction", "expect": ["disaster p4 move to=north(junction,15)"] },
    { "text": "cancel the fire", "expect": ["disaster fire delete"] },
    { "text": "cancel p3", "expect": ["disaster p3 delete"] },
    { "text": "delete P3", "expect": ["disaster p3 delete"] },
    { "text": "move p3", "ask": "place" },
    { "text": "please stop", "expect": ["pause"] },
    { "text": "remove all trees", "expect": ["delete type:tree"] }
  ]
}
