{
  "class": "camera",
  "lang": "en",
  "cases": [
    { "text": "show me the tallest building", "expect": ["focus type:building tallest"] },
    { "text": "Show me the tallest building, please", "expect": ["focus type:building tallest"] },
    { "text": "go to the highest building", "expect": ["focus type:building tallest"] },
    { "text": "look at the selection", "expect": ["focus selection"] },
    { "text": "zoom to this", "expect": ["focus selection"] },
    { "text": "look at what I just placed", "expect": ["focus last"] },
    { "text": "focus on the new ones", "expect": ["focus last"] },
    { "text": "focus on it", "expect": ["focus it"] },
    { "text": "go to n4", "expect": ["focus at=node:n4"] },
    { "text": "go to node n2", "expect": ["focus at=node:n2"] },
    { "text": "show me junction n3", "expect": ["focus at=node:n3"] },
    { "text": "zoom to the junction", "expect": ["focus at=junction"] },
    { "text": "show me the hill", "expect": ["focus at=feature:hill"] },
    { "text": "show me the mountain", "expect": ["focus at=feature:mountain"] },
    { "text": "go to the lake", "expect": ["focus at=feature:lake"] },
    { "text": "could you zoom to the river", "expect": ["focus at=feature:river"] },
    { "text": "go to the centre", "expect": ["focus at=center"] },
    { "text": "go to the middle of the map", "expect": ["focus at=center"] },
    { "text": "go to the intersection", "expect": ["focus at=junction"] },
    { "text": "zoom to this spot", "expect": ["focus at=cursor"] },
    { "text": "zoom to (40, 60)", "expect": ["focus at=40,60"] },
    { "text": "go to -20, 35", "expect": ["focus at=-20,35"] },
    { "text": "show me the group \"North block\"", "expect": ["focus group:\"North block\""] },
    { "text": "look at \"Depot A\"", "expect": ["focus name:\"Depot A\""] },
    { "text": "look at #building_ab12", "expect": ["focus #building_ab12"] },
    { "text": "focus on the largest building", "expect": ["focus type:building largest"] },
    { "text": "look at the nearest tree", "expect": ["focus type:tree nearest cursor"] },
    { "text": "show me the building nearest to n4", "expect": ["focus type:building nearest node:n4"] },
    { "text": "show me the trucks", "expect": ["focus type:car:truck"] },
    { "text": "focus on the buildings with brace warnings", "expect": ["focus type:building where warning=brace"] },
    { "text": "zoom to the buildings with warnings", "expect": ["focus type:building where warning"] },
    { "text": "show the hidden trees again", "expect": ["show type:tree where hidden"] },
    { "text": "move the selection to node n4", "expect": ["move selection to=node:n4"] }
  ]
}
