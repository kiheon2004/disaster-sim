{
  "class": "query",
  "lang": "en",
  "cases": [
    { "text": "how many buildings?", "expect": ["count type:building"] },
    { "text": "How many buildings are there?", "expect": ["count type:building"] },
    { "text": "how many trees are there?", "expect": ["count type:tree"] },
    { "text": "how many cars are on the road?", "expect": ["count type:car where on road"] },
    { "text": "how many trucks are there?", "expect": ["count type:car:truck"] },
    { "text": "how many people?", "expect": ["count type:human"] },
    { "text": "how many are hidden?", "expect": ["count all where hidden"] },
    { "text": "how many are in the selection?", "expect": ["count selection"] },
    { "text": "how many houses have at least 2 floors?", "expect": ["count type:building:house where floors>=2"] },
    { "text": "how many buildings are taller than 10 m?", "expect": ["count type:building where height>10"] },
    { "text": "how many disasters?", "expect": ["count disasters"] },
    { "text": "how many groups are there", "expect": ["count groups"] },
    { "text": "how many roads?", "expect": ["count roads"] },
    { "text": "which have brace warnings?", "expect": ["list all where warning=brace"] },
    { "text": "how many buildings? which buildings have brace warnings?", "expect": ["count type:building", "list type:building where warning=brace"] },
    { "text": "how many trees? how many cars?", "expect": ["count type:tree", "count type:car"] },
    { "text": "which buildings have brace warnings?", "expect": ["list type:building where warning=brace"] },
    { "text": "list the buildings with warnings", "expect": ["list type:building where warning"] },
    { "text": "which buildings are locked?", "expect": ["list type:building where locked"] },
    { "text": "list the cars on the road", "expect": ["list type:car where on road"] },
    { "text": "list the hidden trees", "expect": ["list type:tree where hidden"] },
    { "text": "list all trees", "expect": ["list type:tree"] },
    { "text": "list the disasters", "expect": ["list disasters"] },
    { "text": "what groups are there?", "expect": ["list groups"] },
    { "text": "list the roads", "expect": ["list roads"] },
    { "text": "how far is it from n1 to n4?", "expect": ["measure node:n1 node:n4"] },
    { "text": "distance between here and the junction", "expect": ["measure cursor junction"] },
    { "text": "how far from here to over there", "expect": ["measure cursor view"] },
    { "text": "distance from (0, 0) to (30, 40)", "expect": ["measure 0,0 30,40"] },
    { "text": "distance between the selection and #building_ab12", "expect": ["measure selection #building_ab12"] },
    { "text": "how tall is the selection?", "expect": ["measure selection"] },
    { "text": "how tall is the tallest building?", "expect": ["measure type:building tallest"] },
    { "text": "how big is this?", "expect": ["measure selection"] },
    { "text": "how big are the new ones?", "expect": ["measure last"] },
    { "text": "info on #building_ab12", "expect": ["info #building_ab12"] },
    { "text": "tell me about the selection", "expect": ["info selection"] },
    { "text": "info on the group \"North block\"", "expect": ["info group:\"North block\""] },
    { "text": "what is this?", "expect": ["info selection"] },
    { "text": "tell me about the largest building", "expect": ["info type:building largest"] },
    { "text": "damage", "expect": ["info sim"] },
    { "text": "how much collapsed?", "expect": ["info sim"] },
    { "text": "collapse summary", "expect": ["info sim"] },
    { "text": "how many buildings? which have brace warnings?", "expect": ["count type:building", "list type:building where warning=brace"] },
    { "text": "how many cars are there? which are locked?", "expect": ["count type:car", "list type:car where locked"] }
  ]
}
