    { "text": "rotate these 45° counter-clockwise", "expect": ["rotate selection by=45"] },
    { "text": "rotate it 15 deg anticlockwise", "expect": ["rotate it by=15"] },
    { "text": "turn the new ones around", "expect": ["rotate last by=180"] },
    { "text": "make the selection twice as big", "expect": ["scale selection x2"] },
