    { "text": "move this 3 north", "ask": "amount" },
    { "text": "rotate 30", "ask": "amount" },
    { "text": "move it 1 m to the right", "ask": "direction" },
    { "text": "move it back 2 m", "ask": "direction" },
    { "text": "move it 5 m", "ask": "direction" },
