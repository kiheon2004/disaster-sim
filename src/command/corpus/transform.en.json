{
  "class": "transform",
  "lang": "en",
  "cases": [
    { "text": "move the selection 5 m east and turn it 30°", "expect": ["move selection by=5,0,0", "rotate selection by=30"] },
    { "text": "move the selection 5 m east", "expect": ["move selection by=5,0,0"] },
    { "text": "move this 3 metres north", "expect": ["move selection by=0,0,-3"] },
    { "text": "move the ones I just made 10 m west", "expect": ["move last by=-10,0,0"] },
    { "text": "move them 2.5 m south", "expect": ["move it by=0,0,2.5"] },
    { "text": "please move the selection ten metres south", "expect": ["move selection by=0,0,10"] },
    { "text": "move this 50 cm east", "expect": ["move selection by=0.5,0,0"] },
    { "text": "raise it by 0.5 m", "expect": ["move it by=0,0.5,0"] },
    { "text": "lower the selection 1 m", "expect": ["move selection by=0,-1,0"] },
    { "text": "move these buildings up three meters", "expect": ["move selection by=0,3,0"] },
    { "text": "move the selection to n4", "expect": ["move selection to=node:n4"] },
    { "text": "move this to (40, 60)", "expect": ["move selection to=40,60"] },
    { "text": "move what I just placed to here", "expect": ["move last to=cursor"] },
    { "text": "move the group \"North block\" to the centre", "expect": ["move group:\"North block\" to=center"] },
