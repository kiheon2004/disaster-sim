    { "text": "scale all trees to half the size", "expect": ["scale type:tree x0.5"] },
    { "text": "scale the new ones 1.5 times", "expect": ["scale last x1.5"] },
    { "text": "make it 10% bigger", "expect": ["scale it x1.1"] },
    { "text": "make them half the size", "expect": ["scale it x0.5"] },
    { "text": "set x to 10 for the selection", "expect": ["set selection x=10"] },
    { "text": "set x to 12.5 for everything", "expect": ["set all x=12.5"] },
    { "text": "set x to 10", "expect": ["set it x=10"] },
    { "text": "set the heading of these buildings to 90°", "expect": ["set selection heading=90"] },
    { "text": "set the scale of the selection to 1.5", "expect": ["set selection scale=1.5"] },
    { "text": "set y to 3 and the heading to 270°", "expect": ["set it y=3 heading=270"] },
    { "text": "put the selection 2 m above the ground", "expect": ["set selection lift=2"] },
    { "text": "drop all trees to the ground", "expect": ["set type:tree lift=0"] },
    { "text": "set this 0.5 m above the ground", "expect": ["set selection lift=0.5"] },
    { "text": "ROTATE THE SELECTION BY 30 DEGREES", "expect": ["rotate selection by=30"] },
    { "text": "move it down 2 m", "expect": ["move it by=0,-2,0"] },
    { "text": "move it half a metre east", "expect": ["move it by=0.5,0,0"] },
    { "text": "move the selected ones 5 m west", "expect": ["move selection by=-5,0,0"] },
    { "text": "move the selection 0.05 km east", "expect": ["move selection by=50,0,0"] },
    { "text": "move those 4 m north", "expect": ["move it by=0,0,-4"] },
    { "text": "move it to 6 m south of n4", "expect": ["move it to=south(node:n4,6)"] },
    { "text": "raise them all by 0.5 m", "expect": ["move it by=0,0.5,0"] },
    { "text": "move these all 4 m west", "expect": ["move selection by=-4,0,0"] },
    { "text": "move these to n4", "expect": ["move selection to=node:n4"] },
    { "text": "move it to the south of n4", "expect": ["move it to=south(node:n4)"] },
    { "text": "move the selection to the east of #building_ab12", "expect": ["move selection to=east(#building_ab12)"] },
